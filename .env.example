# Copy to .env. Never commit .env.
# The app runs locally with fixtures and deterministic panel reviews when keys are empty.

USE_FIXTURES=true
START_PANELS_ON_SCREEN=false

ORCH_PORT=4000
ACTOR_PORT=8787
ACTOR_URL=http://127.0.0.1:8787
ACTOR_ALARM_MS=90000
PANEL_SERVICE_URL=http://127.0.0.1:8000

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_SMART=gpt-4o

GITHUB_TOKEN=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPERSERVE_API_KEY=

TERSE_ACTOR_URL=
TERSE_API_KEY=

RELAY_WORKSPACE=
RELAY_API_KEY=
RELAY_BASE_URL=
